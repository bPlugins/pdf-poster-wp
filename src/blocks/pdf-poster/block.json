{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "2.6.0",
  "name": "pdfp/pdfposter",
  "title": "PDF Poster",
  "description": "Embed PDF in your posts and pages",
  "category": "design",
  "icon": "pdf",
  "keywords": [
    "PDF poster",
    "Document poster",
    "PDF Embedder"
  ],
  "editorScript": [
    "file:./index.js",
    "pdfp-public",
    "wp-block-editor"
  ],
  "editorStyle": [
    "file:./index.css",
    "file:./style-index.css"
  ],
  "style": "file:./view.css",
  "render": "file:./render.php",
  "viewScript": [
    "file:./view.js",
    "pdfp-public",
    "adobe-viewer"
  ],
  "textdomain": "pdfp",
  "attributes": {
    "align": {
      "type": "string",
      "default": "none"
    },
    "alignment": {
      "type": "string",
      "default": "left"
    },
    "file": {
      "type": "string",
      "default": ""
    },
		"fileId": {
			"type": "number",
			"default": 0
		},
    "title": {
      "type": "string",
      "default": ""
    },
    "titleFontSize": {
      "type": "string",
      "default": "16px"
    },
    "height": {
      "type": [
        "string",
        "object"
      ],
      "default": {
        "desktop": "840px",
        "tablet": "700px",
        "mobile": "400px"
      }
    },
    "width": {
      "type": [
        "object",
        "string"
      ],
      "default": {
        "desktop": "100%",
        "tablet": "100%",
        "mobile": "100%"
      }
    },
    "showName": {
      "type": "boolean",
      "default": false
    },
    "print": {
      "type": "boolean",
      "default": false
    },
    "onlyPDF": {
      "type": "boolean",
      "default": false
    },
    "defaultBrowser": {
      "type": "boolean",
      "default": false
    },
    "keyboardNav": {
      "type": "boolean",
      "default": false
    },
    "rtlMode": {
      "type": "string",
      "default": "off"
    },
    "themeMode": {
      "type": "string",
      "default": "light"
    },
    "annotationMode": {
      "type": "boolean",
      "default": true
    },
    "openLinksInNewTab": {
      "type": "boolean",
      "default": false
    },
    "progressiveLoading": {
      "type": "boolean",
      "default": true
    },
    "downloadButton": {
      "type": "boolean",
      "default": false
    },
    "downloadButtonText": {
      "type": "string",
      "default": "Download File"
    },
    "fullscreenButton": {
      "type": "boolean",
      "default": true
    },
    "fullscreenButtonText": {
      "type": "string",
      "default": "View Fullscreen"
    },
    "actionsPosition": {
      "type": "string",
      "default": "top"
    },
    "newWindow": {
      "type": "boolean",
      "default": false
    },
    "protect": {
      "type": "boolean",
      "default": false
    },
    "thumbMenu": {
      "type": "boolean",
      "default": false
    },
    "sidebarOpen": {
      "type": "boolean",
      "default": false
    },
    "initialPage": {
      "type": "number",
      "default": 0
    },
    "zoomLevel": {
      "type": "number"
    },
    "alert": {
      "type": "boolean",
      "default": false
    },
    "lastVersion": {
      "type": "boolean",
      "default": false
    },
    "hrScroll": {
      "type": "boolean",
      "default": false
    },
    "isHideRightToolbar": {
      "type": "boolean",
      "default": false
    },
    "btnStyles": {
      "type": "object"
    },
    "additional": {
      "type": "object",
      "default": {
        "ID": "",
        "Class": "",
        "CSS": ""
      }
    },
    "adobeEmbedder": {
      "type": "string",
      "default": "default"
    },
    "flipbookSourceType": {
      "type": "string",
      "default": "pdf"
    },
    "flipbookImages": {
      "type": "array",
      "default": []
    },
    "flipbookSound": {
      "type": "boolean",
      "default": true
    },
    "adobeOptions": {
      "type": "object",
      "default": {
        "showDownloadPDF": true,
        "showPrintPDF": true,
        "showAnnotationTools": true,
        "showFullScreen": false,
        "embedMode": "SIZED_CONTAINER"
      }
    },
    "popupOptions": {
      "type": "object",
      "default": {
        "enabled": false,
        "triggerType": "button",
        "triggerAlignment": "center",
        "image": "",
        "imagePdfIcon": true,
        "imageHeight": "200px",
        "imageWidth": "300px",
        "text": "Open PDF",
        "btnStyle": {
          "background": "#2271b1",
          "color": "#fff",
          "fontSize": "16px",
          "padding": {
            "top": 10,
            "right": 20,
            "bottom": 10,
            "left": 10
          }
        }
      }
    },
    "popupBtnStyle": {
      "type": "object",
      "default": {
        "background": "#2271b1",
        "color": "#fff",
        "padding": {
          "top": 10,
          "right": 20,
          "bottom": 10,
          "left": 10
        }
      }
    },
    "popupBtnText": {
      "type": "string",
      "default": "Open Document"
    },
    "CSS": {
      "type": "string",
      "default": ""
    },
    "socialShare": {
      "type": "object",
      "default": {
        "enabled": false,
        "facebook": true,
        "twitter": true,
        "linkedin": true,
        "pinterest": true,
        "mailto": true,
        "position": "top"
      }
    },
    "posterId": {
      "type": "number",
      "default": 0
    },
    "trackingEnabled": {
      "type": "boolean",
      "default": true
    },
    "trackDepth": {
      "type": "boolean",
      "default": false
    },
    "watermark": {
      "type": "object",
      "default": {
        "enabled": false,
        "markType": "text",
        "theme": "confidential",
        "text": "CONFIDENTIAL",
        "image": "",
        "imageStyle": "grayscale",
        "color": "#808080",
        "coverage": "normal",
        "position": "center",
        "strength": "subtle",
        "size": "medium",
        "angle": "diagonal",
        "apply": ["screen"],
        "pages": "all",
        "audience": "everyone",
        "antileak": false,
        "stamp": false,
        "lock": false,
        "dynamic": false
      }
    }
  },
  "supports": {
    "html": false,
    "lock": false,
    "align": [
      "full",
      "wide"
    ]
  },
  "example": {
    "attributes": {
      "preview": true
    }
  }
}